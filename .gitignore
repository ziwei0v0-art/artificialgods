# Keep Git focused on the current source, production art and selected records.
/*
!/.gitignore
!/README.md
!/LICENSE
!/ASSET-LICENSES.md
!/AGENTS.md
!/成熟实现复用记录_1.0.md
!/native/
!/tianmu_mvp/
!/tools/
!/tests/
!/third_party/
!/docs/
!/assets/
/assets/*
!/assets/production/
!/assets/incoming/
/assets/incoming/*
!/assets/incoming/bottle_20261003/
!/assets/incoming/insects_oga_20261001/
!/evidence/
/evidence/*
!/evidence/1.0/
/evidence/1.0/*
!/evidence/1.0/174-design.md
!/evidence/1.0/174-traditional-time.md
!/evidence/1.0/174-visual-reference-audit.md
!/evidence/1.0/174-ui-observation.md
!/evidence/1.0/174-final-regression-summary.json
!/evidence/1.0/174-run-safe-regression.py
!/evidence/1.0/176-run-targeted-checks.py
!/evidence/1.0/176-targeted-checks.json

# Generated output, machine settings, credentials and game saves stay local.
**/.DS_Store
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.swiftpm/
**/.build/
**/node_modules/
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.app/
**/state.json
**/state.json.*
**/体验存档/
**/新建验证档/

# Rejected animation candidates are retained locally, outside public source.
/assets/production/A01/walk-pixel-20261001.png
/assets/production/A01/manifest-pixel-walk-withdrawn-20261001.json
